          "cachedResultName": "gpt-4o"
        },
        "messages": {
          "values": [
            {
              "content": "Jesteś copywriterem social media dla Halo Efekt — polskiej agencji automatyzacji biznesu opartej na AI. Twój styl: rzeczowy, korzyść-first, bez buzzwordów. Piszesz po polsku.\n\nWygeneruj 3 wersje posta dla różnych platform na podstawie podanego tematu. Odpowiedz WYŁĄCZNIE w formacie JSON:\n{\n  \"linkedin\": \"...\",\n  \"facebook\": \"...\",\n  \"instagram\": \"...\"\n}\n\nWytyczne:\n- LinkedIn: profesjonalny, merytoryczny, 150-200 słów, zakończ CTA\n- Facebook: konwersacyjny, angażujący, 80-120 słów, możesz użyć 1-2 emoji\n- Instagram: zwięzły, energiczny, max 150 słów + 5-8 hashtagów PL na końcu",
              "role": "system"
            },
            {
              "content": "=Temat: {{ $json.topic }}\nTon: {{ $json.tone || 'profesjonalny' }}",
              "role": "user"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "id": "f3a1c2d4-2001-4002-8002-aabbcc000002",
      "name": "OpenAI: Generate Captions",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [
        460,
        300
      ],
      "credentials": {
        "openAiApi": {
          "id": "3",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-01",
